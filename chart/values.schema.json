{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "environment"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "lab": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maxLatencyMilliseconds": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "load": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namePrefix": { "type": "string", "minLength": 1 },
        "targetUrl": { "type": "string", "minLength": 1 },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "script"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "script": { "type": "string", "pattern": "^[a-z0-9-]+\\.js$" }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "secretEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "secretName", "key"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "secretName": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
